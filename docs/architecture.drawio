block;endFill=1;" edge="1" parent="1" source="flow-4" target="flow-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-6" target="flow-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-7" target="flow-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-8" target="flow-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-17" value="outbox wakes sender" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-7" target="flow-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="flow-10" target="flow-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-19" value="&lt;b&gt;spacepush_stream:broadcast/1&lt;/b&gt;&lt;br&gt;called by the poller after&lt;br&gt;commit returns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="290" width="220" height="70" as="geometry"/></mxCell><mxCell id="flow-20" value="&lt;b&gt;pg:get_members&lt;/b&gt;&lt;br&gt;per topic {Endpoint, Room}&lt;br&gt;Pid ! {spacepush_change, …}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="290" width="220" height="70" as="geometry"/></mxCell><mxCell id="flow-21" value="&lt;b&gt;spacepush_http_stream&lt;/b&gt;&lt;br&gt;writes SSE event&lt;br&gt;event: change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="flow-22" value="&lt;b&gt;spacestate notify&lt;/b&gt;&lt;br&gt;(SpaceStateCLI via SpaceStateKit)&lt;br&gt;notify-send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="flow-23" value="after commit/3 returns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;dashed=1;fontColor=#2d6a2d;" edge="1" parent="1" source="flow-9" target="flow-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;dashed=1;fontColor=#2d6a2d;" edge="1" parent="1" source="flow-19" target="flow-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;dashed=1;fontColor=#2d6a2d;" edge="1" parent="1" source="flow-20" target="flow-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-26" value="SSE over HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;dashed=1;fontColor=#2d6a2d;" edge="1" parent="1" source="flow-21" target="flow-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-27" value="&lt;b&gt;Why the stream needs no outbox&lt;/b&gt;&lt;br&gt;• A VM crash closes every stream; clients notice and reconnect.&lt;br&gt;• On every (re)connect the client reads the current state via GET /v1/spaces / /v1/mainframe/rooms (same freshness rules as the apps).&lt;br&gt;• The newest state always wins, so a missed event only delays, it never leaves a wrong state.&lt;br&gt;• broadcast/1 touches no file and runs after the commit, so the commit protocol and its crash tests stay unchanged." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="720" height="110" as="geometry"/></mxCell><mxCell id="flow-28" value="&lt;b&gt;Reconnect&lt;/b&gt;&lt;br&gt;client: exponential backoff + jitter,&lt;br&gt;server sends retry: hint;&lt;br&gt;heartbeat comment every ~25 s keeps&lt;br&gt;the proxy from closing idle streams" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="400" width="240" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
