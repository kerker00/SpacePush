{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {gun, "2.6.0"},
    {cowboy, "2.19.0"}
]}.

{relx, [
    {release, {spacepush, "0.2.0"}, [spacepush, sasl]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod}]}]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [spacepush]}
]}.
